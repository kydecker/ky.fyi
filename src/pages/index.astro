---
import { getCollection } from "astro:content";
import Center from "../components/Center.astro";
import GuestbookFeed from "../components/Home/GuestbookFeed.astro";
import ProjectGrid from "../components/Home/ProjectGrid.astro";
import PostList from "../components/PostList.astro";
import Synth from "../components/Synth/Synth.astro";
import { siteInfo } from "../constants/site-info";
import { sortFeaturedFirst } from "../helpers/sortFeaturedFirst";
import BaseLayout from "../layouts/BaseLayout.astro";

const PROJECTS_CUTOFF = 4;
const WRITING_CUTOFF = 2;

const projects = await getCollection("projects");
const sortedProjects = projects
  .map((project) => ({
    id: project.id,
    ...project.data,
  }))
  .sort(sortFeaturedFirst);

const posts = await getCollection("posts");
const sortedPosts = posts.sort(
  (a, b) => b.data.datePublished.getTime() - a.data.datePublished.getTime(),
);
---

<BaseLayout
  title={siteInfo.name}
  description={siteInfo.description}
  includeFooter
>
  <section class="home">
    <Center>
      <h1 class="intro">
        <p>
          <a href="/about">Ky Decker</a> designs interfaces in NYC with{" "}
          <span data-sam-text>Samwise</span>
          <template data-sam-template>
            <button type="button" data-sam-button>Samwise</button>
          </template>
        </p>
      </h1>
      <div class="synth">
        <Synth />
      </div>
    </Center>
  </section>
  <section>
    <Center>
      <h2>Things I've made</h2>
      <ProjectGrid items={sortedProjects} cutoff={PROJECTS_CUTOFF} eager={1} />
    </Center>
  </section>
  <section>
    <Center>
      <h2>Latest writing</h2>
      <PostList posts={sortedPosts} cutoff={WRITING_CUTOFF} />
    </Center>
  </section>
  <section>
    <Center>
      <h2>From the guestbook</h2>
    </Center>
    <GuestbookFeed />
  </section>
</BaseLayout>

<script>
  // Swap the plain text for a button, so it's only clickable with JS
  const template = document.querySelector<HTMLTemplateElement>(
    "[data-sam-template]",
  );
  const button = template?.content.firstElementChild;
  if (button) document.querySelector("[data-sam-text]")?.replaceWith(button);
  template?.remove();

  // Loaded on demand so stickers stay off the critical path
  const loadStickers = () => import("../components/Stickers/stickers");

  button?.addEventListener("pointerenter", loadStickers, { once: true });
  button?.addEventListener("focus", loadStickers, { once: true });
  button?.addEventListener("click", async () => {
    const { addSam } = await loadStickers();
    addSam();
  });
</script>

<style>
  .home {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xl);
  }

  .intro {
    padding-block: var(--space-2xl);
    user-select: none;

    p {
      font-size: var(--step-4);
      letter-spacing: var(--letter-spacing-condensed);
      line-height: var(--line-height-tight);
      padding-block-end: var(--space-l);
      font-weight: var(--font-weight-medium);
      text-wrap: balance;

      @media (width > 630px) {
        text-align: center;
      }
    }

    /* The Samwise text matches the button it's swapped for */
    a,
    button,
    [data-sam-text] {
      text-decoration: underline;
      text-decoration-color: var(--gray-a6);
      text-underline-offset: max(0.08em, 2.5px);
      text-decoration-skip-ink: none;
    }

    a,
    button {
      background: unset;
      border: unset;
      margin: unset;
      line-height: unset;
      display: unset;
      padding: unset;
      letter-spacing: inherit;
      cursor: pointer;
      color: inherit;
      transition:
        text-decoration-color 0.2s ease-in-out,
        font-weight 0.2s ease-in-out;

      @media (hover: hover) and (pointer: fine) {
        &:hover {
          color: var(--gray-12);
          text-decoration-color: var(--gray-a10);
          font-weight: var(--font-weight-extrabold);
        }
      }

      &:focus-visible {
        color: var(--gray-12);
        text-decoration-color: transparent;
        font-weight: var(--font-weight-extrabold);
      }
    }
  }

  /* Without JS, Samwise stays plain text */
  @media (scripting: none) {
    .intro [data-sam-text] {
      text-decoration: none;
    }
  }

  .synth {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  [data-sam-button] {
    cursor: pointer;
    /* Rapid taps add Sams rather than double-tap zooming */
    touch-action: manipulation;

    &:active {
      transform: scale(0.95);
    }
  }

  section {
    width: 100%;
    padding-block-end: var(--space-3xl);
  }

  h2 {
    font-size: var(--step-2);
    margin-block-end: var(--space-l);
  }
</style>
