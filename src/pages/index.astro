---
import { getCollection } from "astro:content";
import Center from "../components/Center.astro";
import GuestbookFeed from "../components/Home/GuestbookFeed.astro";
import ProjectGrid from "../components/Home/ProjectGrid.astro";
import PostLink from "../components/PostLink.astro";
import Synth from "../components/Synth/Synth.astro";
import { siteInfo } from "../constants/site-info";
import BaseLayout from "../layouts/BaseLayout.astro";

const work = await getCollection("work");

const feed = work
  .map((project) => ({
    id: project.id,
    ...project.data,
  }))
  .sort((a, b) => b.year - a.year);

const posts = await getCollection("posts");

const latestPost = posts.sort(
  (a, b) => b.data.datePublished.getTime() - a.data.datePublished.getTime(),
)[0];
---

<BaseLayout
  title={siteInfo.name}
  description={siteInfo.description}
  includeFooter
>
  <section class="home">
    <Center>
      <h1 class="intro">
        <p>
          <a href="/about">Ky Decker</a> makes worldwide websites in NYC with{" "}
          <button type="button" data-sam-button>
            Samwise
          </button>
        </p>
      </h1>
      <div class="synth">
        <Synth />
      </div>
    </Center>
  </section>
  <section>
    <Center>
      <h2>Projects</h2>
      <ProjectGrid items={feed} />
    </Center>
  </section>
  <section>
    <Center>
      <h2>
        Latest <a href="/posts">writing</a>
      </h2>
      <PostLink post={latestPost} />
    </Center>
  </section>
  <section>
    <Center>
      <h2>
        From the <a href="/guestbook">guestbook</a>
      </h2>
    </Center>
    <GuestbookFeed />
  </section>
</BaseLayout>

<script>
  import * as Fathom from "fathom-client";
  import { addSam } from "../stores/sam";

  function setupSam() {
    const samButton = document.querySelector("[data-sam-button]");
    samButton?.addEventListener("click", () => addSam());
  }

  setupSam();

  document.addEventListener("astro:after-swap", () => {
    setupSam();
  });

  document.addEventListener("astro:page-load", () => {
    document
      .querySelector("[data-sam-button]")
      ?.addEventListener("click", () => {
        Fathom.trackEvent("stickers: add sam");
      });

    document.querySelector("[data-sam-shoo]")?.addEventListener("click", () => {
      Fathom.trackEvent("stickers: shoo sam");
    });
  });
</script>

<style>
  .home {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xl);
  }

  .intro {
    padding-block: var(--space-2xl);
    user-select: none;

    p {
      font-size: var(--step-4);
      letter-spacing: var(--letter-spacing-condensed);
      line-height: var(--line-height-tight);
      padding-block-end: var(--space-l);
      font-weight: var(--font-weight-medium);
      text-align: center;
      text-wrap: balance;
    }

    a,
    button {
      background: unset;
      border: unset;
      margin: unset;
      line-height: unset;
      display: unset;
      padding: unset;
      cursor: pointer;
      color: inherit;
      text-decoration: underline;
      text-decoration-color: var(--gray-8);
      text-underline-offset: max(0.1em, 2.5px);
      transition:
        text-decoration-color 0.2s ease-in-out,
        font-weight 0.2s ease-in-out;

      @media (hover: hover) and (pointer: fine) {
        &:hover {
          font-weight: var(--font-weight-extrabold);
          text-decoration-color: var(--gray-11);
        }
      }
    }
  }

  .synth {
    display: flex;
    align-items: center;
    justify-content: center;

    @media (width > 640px) {
      background: var(--gray-3);
      border-radius: var(--radius-m);
      padding: var(--space-xl) var(--space-l);
    }
  }

  [data-sam-button] {
    cursor: pointer;

    &:active {
      transform: scale(0.95);
    }
  }

  section {
    width: 100%;
    padding-block-end: var(--space-3xl);
  }

  h2 {
    font-size: var(--step-1);
    margin-block-end: var(--space-m);
  }
</style>
