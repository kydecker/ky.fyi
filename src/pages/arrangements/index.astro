---
import { getCollection } from "astro:content";
import { Score } from "astro-lilypond";
import ProseLayout from "../../layouts/ProseLayout.astro";

const title = "Sheet Music";
const description = "Play these notes at a piano.";

const scores = await getCollection("scores");
---

<ProseLayout title={title} description={description}>
  <p>
    Below are some piano arrangements I've composed. All music was typeset using{" "}
    <a href="https://lilypond.org">LilyPond</a>, a text-based music engraving
    language. Scores are displayed here using{" "}
    <a href="https://lilypond.ky.fyi">astro-lilypond</a>, an open source Astro
    integration I built.
  </p>
  <section class="arrangements-grid">
    {scores.map((score) => (
      <a href={`/arrangements/${score.id}`} class="arrangement">
        <Score content={score.data} pageLimit={1} />
        <div>
          <h2>
            {score.data.meta.title}
            {score.data.meta.subtitle && ` (${score.data.meta.subtitle})`}
          </h2>
          <span>Composed by {score.data.meta.composer}</span>
        </div>
      </a>
    ))}
  </section>
</ProseLayout>

<style>
  .arrangements-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
    padding-block: var(--space-2xl);

    @media (width < 460px) {
      grid-template-columns: 1fr;
    }
  }

  .arrangement {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
    text-decoration: none;

    h2 {
      font-size: var(--step-0);
      margin-block: 0 var(--space-xs);
    }

    span {
      display: block;
      font-size: var(--step--1);
      line-height: var(--line-height-tight);
    }

    img {
      box-shadow: 0 0 0 1px var(--gray-a4);
    }

    &:focus-visible {
      outline: none;

      img {
        outline: var(--gray-12) solid 3px;
        outline-offset: 3px;
      }
    }

    @media (hover: hover) {
      img {
        transition: transform 0.15s ease;
      }

      &:hover {
        img {
          transform: translateY(-5px);
        }
      }
    }
  }

  :global(ol[data-lilypond-group]) {
    padding: var(--space-l) 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-s);
    list-style-type: none;

    @media (width > 600px) {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
