---
import { getCollection } from "astro:content";
import { getScore, type LilypondScore } from "astro-lilypond";
import { Icon } from "../../components/Icon/Icon";
import ProseLayout from "../../layouts/ProseLayout.astro";

export async function getStaticPaths() {
  const scores = await getCollection("scores");

  return scores.map((score) => ({
    params: { id: score.id },
    props: { score: score.data },
  }));
}

interface Props {
  score: LilypondScore;
}

const { score } = Astro.props;

const { Score, meta, pdf } = await getScore(score, { pdf: true });

const { title, composer, arranger } = meta;

const description = [
  composer && `Composed by ${composer}`,
  arranger && `Arranged by ${arranger}`,
]
  .filter(Boolean)
  .join(". ");
---

<ProseLayout
  title={title ?? "Untitled"}
  description={description ?? "A score by Ky Decker"}
>
  <div class="links">
    <a href="/arrangements">
      <Icon icon="arrowLeft" />
      All sheets
    </a>
    {pdf && (
      <a href={pdf.src} download>
        Download PDF
      </a>
    )}
  </div>
  <Score class="score" />
</ProseLayout>

<style>
  .links {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-l);
    width: 100%;
    padding-block-end: var(--space-xl);

    a {
      display: inline-flex;
      align-items: center;
      gap: var(--space-xs);
      white-space: nowrap;
    }
  }

  :global(.prose ol[data-lilypond-group]) {
    display: flex;
    flex-direction: column;
    gap: var(--space-l);
    list-style: none;
    padding: 0;
    margin: 0 !important;

    li::before {
      content: none;
    }

    img {
      max-inline-size: 100%;
    }
  }
</style>
