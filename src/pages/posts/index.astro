---
import { getCollection } from "astro:content";
import Center from "../../components/Center.astro";
import PageHeader from "../../components/PageHeader.astro";
import PostList from "../../components/PostList.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Writing";
const description =
  "Case studies, tutorials, reflections, and other writing on design and tech.";

const posts = await getCollection("posts");

const writing = posts.sort(
  (a, b) => b.data.datePublished.getTime() - a.data.datePublished.getTime(),
);
---

<BaseLayout title={title} description={description} includeFooter padBottom>
  <PageHeader title={title} description={description} />
  <Center>
    <PostList posts={writing} />
  </Center>
</BaseLayout>
