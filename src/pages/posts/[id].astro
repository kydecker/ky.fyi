---
import { type CollectionEntry, getCollection, render } from "astro:content";
import H2 from "../../components/Headings/H2.astro";
import H3 from "../../components/Headings/H3.astro";
import H4 from "../../components/Headings/H4.astro";
import H5 from "../../components/Headings/H5.astro";
import H6 from "../../components/Headings/H6.astro";
import ProjectInfo from "../../components/ProjectInfo.astro";
import ProseLayout from "../../layouts/ProseLayout.astro";

export interface Props {
  post: CollectionEntry<"posts">;
  prev: CollectionEntry<"posts"> | null;
  next: CollectionEntry<"posts"> | null;
}

export async function getStaticPaths() {
  const posts = await getCollection("posts");

  return posts
    .sort((a, b) => (a.data.datePublished < b.data.datePublished ? -1 : 1))
    .map((post, index) => ({
      params: { id: post.id },
      props: {
        post,
        prev: posts[index - 1],
        next: posts[index + 1],
      },
    }));
}
const { post, prev, next } = Astro.props;
const { Content } = await render(post);

const { data } = post;
const {
  title,
  description,
  previewImage,
  projectInfo,
  datePublished,
  dateModified,
} = data;

const headingComponents = { h2: H2, h3: H3, h4: H4, h5: H5, h6: H6 };
---

<ProseLayout
  title={title}
  description={description}
  previewImage={previewImage}
  datePublished={datePublished}
  dateModified={dateModified}
>
  {projectInfo && <ProjectInfo {...projectInfo} />}
  <Content components={headingComponents} />
  <div class="pagination" slot="after-prose">
    {prev && (
      <a href={prev.id} class="prev">
        <span class="label">Previous</span>
        <span class="title">{prev.data.title}</span>
      </a>
    )}
    {next && (
      <a href={next.id} class="next">
        <span class="label">Next</span>
        <span class="title">{next.data.title}</span>
      </a>
    )}
  </div>
</ProseLayout>

<style>
  .pagination {
    display: flex;
    flex-direction: row;
    margin-block-start: var(--space-3xl);
    margin-inline: auto;
    width: min(860px, calc(100% - var(--space-xl) * 2));
    gap: var(--space-m);
    border-block-start: 1px solid var(--gray-6);
    padding-block-start: var(--space-xl);

    a {
      flex: 1;
      display: flex;
      flex-direction: column;
      row-gap: var(--space-xs);
      line-height: var(--line-height-tight);
      text-decoration: none;
      text-wrap: balance;

      &.prev {
        align-items: flex-start;

        .label::before {
          content: "← ";
          font-family: var(--font-system);
        }
      }

      &.next {
        align-items: flex-end;
        text-align: right;

        .label::after {
          content: " →";
          font-family: var(--font-system);
        }
      }

      .label {
        font-size: var(--step--2);
        color: var(--gray-11);
        transition: color 0.2s ease-in-out;
        font-weight: var(--font-weight-normal);
      }
    }
  }
</style>
