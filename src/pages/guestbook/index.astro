---
import GuestbookEntries from "../../components/Guestbook/GuestbookEntries.astro";
import GuestbookPagination from "../../components/Guestbook/GuestbookPagination.astro";
import Notecard from "../../components/Guestbook/Notecard.astro";
import { NotecardComposer } from "../../components/Guestbook/NotecardComposer";
import {
  getPageRange,
  getPageUrl,
  getTotalPages,
} from "../../components/Guestbook/pagination";
import { getGuestbookCount } from "../../db/queries/select";
import BaseLayout from "../../layouts/BaseLayout.astro";
import guestbookPreview from "./guestbook.png";

export const prerender = false;

const pageParam = Astro.url.searchParams.get("page");
const currentPage = Number(pageParam) || 1;

// Only ?page=N waits on the count, so /guestbook renders without D1.
if (pageParam !== null) {
  if (!Number.isInteger(currentPage) || currentPage <= 1) {
    return Astro.redirect(getPageUrl(1));
  }

  const totalPages = getTotalPages(await getGuestbookCount());
  if (currentPage > totalPages) {
    return Astro.redirect(getPageUrl(totalPages));
  }
}
---

<BaseLayout
  title="Guestbook"
  description="Leave a message in ky.fyi."
  includeFooter
  padBottom
  previewImage={{
    image: guestbookPreview,
    alt: "A collection of hand-drawn postcards. The middle one has a flower drawn with a green highlighter.",
  }}
>
  <h1 class="visually-hidden">Guestbook</h1>
  <div class="notecards">
    {currentPage === 1 && <NotecardComposer client:load />}
    <GuestbookEntries currentPage={currentPage} server:defer>
      <Fragment slot="fallback">
        {Array.from({ length: getPageRange(currentPage).limit }).map(() => (
          <Notecard theme={1} content="" loading />
        ))}
      </Fragment>
    </GuestbookEntries>
  </div>
  <GuestbookPagination currentPage={currentPage} server:defer />
</BaseLayout>

<style>
  .notecards {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: flex-start;
    gap: var(--space-2xl);
    padding: var(--space-xl);
    overflow: hidden;
  }
</style>
