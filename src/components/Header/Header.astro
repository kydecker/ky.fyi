---
import Center from "../Center.astro";
import { Icon } from "../Icon/Icon";
import Logo from "./Logo.astro";
---

<header>
  <Center>
    <nav id="nav">
      <h1>
        <a href="/">
          <Logo />
        </a>
      </h1>
      <div class="links">
        <button type="button" data-theme-toggle aria-label="Toggle theme">
          <Icon icon="sun" size="24" variant="line" className="sun" />
          <Icon icon="moon" size="24" variant="filled" className="moon" />
        </button>
      </div>
    </nav>
  </Center>
</header>

<script>
  import * as Fathom from "fathom-client";

  type Theme = "light" | "dark";

  function getActiveTheme(): Theme {
    return document.documentElement.getAttribute("data-theme") === "dark"
      ? "dark"
      : "light";
  }

  function setActiveTheme(theme: Theme, doc = window.document) {
    doc.documentElement.setAttribute("data-theme", theme);

    // Update localStorage
    window.localStorage.setItem("theme", theme);

    // Update meta theme
    const metaTheme = doc.querySelector('meta[name="theme-color"]');
    if (metaTheme !== null)
      metaTheme.setAttribute(
        "content",
        theme === "dark" ? "#191919" : "#f9f9f9",
      );
  }

  function setupToggle(document = window.document) {
    let toggleButton = document.querySelector("[data-theme-toggle]");

    toggleButton &&
      toggleButton.addEventListener("click", () => {
        // Only animate the icons once the user has toggled the theme, not on page load
        toggleButton.classList.add("animate");
        handleToggleTheme(toggleButton);
      });
  }

  // iOS Safari paints a solid bar behind its toolbars during view transitions.
  // iPadOS reports a Mac user agent, so check for touch support too
  function isIOS() {
    return (
      /iPad|iPhone|iPod/.test(navigator.userAgent) ||
      (/Macintosh/.test(navigator.userAgent) && navigator.maxTouchPoints > 1)
    );
  }

  function handleToggleTheme(origin: Element) {
    const nextTheme = getActiveTheme() === "light" ? "dark" : "light";

    if (
      typeof document.startViewTransition !== "function" ||
      window.matchMedia("(prefers-reduced-motion: reduce)").matches ||
      isIOS()
    ) {
      setActiveTheme(nextTheme);
    } else {
      // Reveal the new theme as a circle growing out from the toggle button,
      // large enough to reach the farthest corner of the viewport
      const { left, top, width, height } = origin.getBoundingClientRect();
      const x = left + width / 2;
      const y = top + height / 2;
      const radius = Math.hypot(
        Math.max(x, window.innerWidth - x),
        Math.max(y, window.innerHeight - y),
      );

      const root = document.documentElement;
      root.style.setProperty("--theme-ripple-x", `${x}px`);
      root.style.setProperty("--theme-ripple-y", `${y}px`);
      root.style.setProperty("--theme-ripple-radius", `${radius}px`);
      root.setAttribute("data-theme-transition", "");

      const transition = document.startViewTransition(() =>
        setActiveTheme(nextTheme),
      );
      transition.finished.finally(() => {
        root.removeAttribute("data-theme-transition");
        root.style.removeProperty("--theme-ripple-x");
        root.style.removeProperty("--theme-ripple-y");
        root.style.removeProperty("--theme-ripple-radius");
      });
    }

    Fathom.trackEvent("nav: toggle theme");
  }

  // Run on initial load
  setupToggle();

  document.addEventListener("astro:before-swap", (ev) => {
    setupToggle(ev.newDocument);
    setActiveTheme(getActiveTheme(), ev.newDocument);
  });

  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll("[data-fathom='nav-link']").forEach((navlink) => {
      navlink.addEventListener("click", () => {
        const url = navlink.getAttribute("href");
        Fathom.trackEvent(`nav: click link (${url})`);
      });
    });
  });
</script>

<style>
  header {
    width: 100%;
    padding-block: var(--space-m);
    z-index: 1;
  }

  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);

    a,
    button {
      display: inline-flex;
      align-items: center;
      background: transparent;
      text-decoration: none;
      line-height: 1;
      color: var(--gray-12);
      padding: var(--space-xs) var(--space-s);
      border: none;
      cursor: pointer;
    }

    h1 {
      font-size: var(--step-0);
      margin: 0;

      a {
        padding-inline: 0;
      }
    }
  }

  .links {
    display: flex;
    align-items: center;
    margin-inline-end: calc(-1 * var(--space-s));

    button[data-theme-toggle] {
      justify-content: center;
      position: relative;
      overflow: hidden;
      box-sizing: content-box;
      width: 24px;
      height: 24px;
      padding-inline: var(--space-xs);
      border-radius: var(--radius-full);

      .icon {
        transform-origin: 50% 200%;
        position: absolute;
      }
    }
  }

  /* The inactive icon waits on the left, ready to rotate in clockwise */
  :global(html:not([data-theme="dark"]) .moon),
  :global([data-theme="dark"] .sun) {
    transform: rotate(-60deg);
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html:not([data-theme="dark"]) .animate .sun),
    :global([data-theme="dark"] .animate .moon) {
      animation: rotate-in 0.4s ease-out;
    }

    :global(html:not([data-theme="dark"]) .animate .moon),
    :global([data-theme="dark"] .animate .sun) {
      animation: rotate-out 0.4s ease-out;
    }
  }

  :global(html[data-theme-transition]) {
    view-transition-name: root !important;
  }

  :global(html[data-theme-transition] *) {
    view-transition-name: none !important;
  }

  :global(html[data-theme-transition]::view-transition-old(root)),
  :global(html[data-theme-transition]::view-transition-new(root)) {
    animation: none;
    mix-blend-mode: normal;
  }

  :global(html[data-theme-transition]::view-transition-new(root)) {
    animation: theme-ripple 0.5s ease-in-out;
  }

  @keyframes theme-ripple {
    from {
      clip-path: circle(0 at var(--theme-ripple-x) var(--theme-ripple-y));
    }
    to {
      clip-path: circle(
        var(--theme-ripple-radius) at var(--theme-ripple-x)
          var(--theme-ripple-y)
      );
    }
  }

  @keyframes rotate-in {
    from {
      transform: rotate(-60deg);
    }
    to {
      transform: rotate(0deg);
    }
  }

  @keyframes rotate-out {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(60deg);
    }
  }
</style>
