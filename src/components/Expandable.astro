---
import { Icon } from "./Icon/Icon";

interface Props {
  layout: "grid" | "list";
  count: number;
  label?: string;
  gap?: string;
  divided?: boolean;
}

const { layout, count, label = "more", gap, divided = false } = Astro.props;
const style = gap ? `--expandable-gap: ${gap}` : undefined;
---

<ul class:list={["expandable-items", layout, { divided }]} style={style}>
  <slot name="visible" />
</ul>
{count > 0 && (
  <details class="expandable">
    <summary class="expandable-trigger">
      {count} {label} <Icon icon="arrowDown" size="20" />
    </summary>
    <ul class:list={["expandable-items", layout, { divided }]} style={style}>
      <slot />
    </ul>
  </details>
)}

<style>
  .expandable-items {
    --expandable-gap: var(--space-xl);
    list-style: none;
    padding: 0;
  }

  .expandable-items.grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--expandable-gap) var(--space-l);

    > * {
      min-width: 0;
    }

    @media (width < 640px) {
      grid-template-columns: 1fr;
    }
  }

  .expandable-items.list {
    display: flex;
    flex-direction: column;
    gap: var(--expandable-gap);
  }

  .divided {
    &.list > :global(:nth-child(n + 2)),
    &.grid > :global(:nth-child(n + 3)),
    .expandable > & > :global(*) {
      padding-block-start: var(--expandable-gap);
      border-block-start: 1px solid var(--gray-6);
    }

    @media (width < 640px) {
      &.grid > :global(:nth-child(2)) {
        padding-block-start: var(--expandable-gap);
        border-block-start: 1px solid var(--gray-6);
      }
    }
  }

  .expandable {
    margin-block-start: var(--space-m);
  }

  .expandable > .expandable-items {
    margin-block-start: var(--expandable-gap);
  }

  .expandable-trigger {
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    padding: var(--space-2xs) var(--space-s);
    margin-inline: calc(var(--space-s) * -1);
    border-radius: var(--radius-full);
    gap: var(--space-2xs);
    color: var(--gray-11);
    text-decoration: none;
    transition: color 0.15s ease-out;

    &:focus-visible {
      color: var(--gray-12);
      font-weight: var(--font-weight-bold);
    }

    &::-webkit-details-marker {
      display: none;
    }

    @media (hover: hover) and (pointer: fine) {
      &:hover {
        color: var(--gray-12);
        font-weight: var(--font-weight-bold);
      }
    }
  }

  .expandable[open] .expandable-trigger {
    display: none;
  }
</style>

<style is:global>
  @media (prefers-reduced-motion: no-preference) {
    .expandable[open] .expandable-items > * {
      animation: expandable-item-in 0.4s ease-out backwards;
      animation-delay: calc((sibling-index() - 1) * 60ms);
    }
  }

  @keyframes expandable-item-in {
    from {
      opacity: 0;
      translate: 0 8px;
    }
  }
</style>
