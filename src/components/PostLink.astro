---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"posts">;
}

const { post } = Astro.props;

const displayDate = post.data.datePublished.getFullYear();
---

<div class="post">
  {post.data.previewImage && (
    <a
      href={`/posts/${post.id}`}
      class="post-image"
      tabindex="-1"
      aria-hidden="true"
    >
      <Image
        src={post.data.previewImage.image}
        alt={post.data.previewImage.alt}
        width={836}
        widths={[418, 640, 836, 1280]}
        sizes="(width < 640px) 100vw, 418px"
      />
    </a>
  )}
  <div class="post-body">
    <div class="post-eyebrow">
      <span>{post.data.category}</span>
      <time datetime={post.data.datePublished.toISOString()}>
        {displayDate}
      </time>
    </div>
    <h2 class="post-title">
      <a href={`/posts/${post.id}`}>{post.data.title}</a>
    </h2>
    <p>{post.data.description}</p>
  </div>
</div>

<style>
  .post {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-l);

    @media (width < 640px) {
      grid-template-columns: 1fr;
    }
  }

  .post-image {
    display: block;

    img {
      display: block;
      width: 100%;
      height: auto;
      aspect-ratio: 1.91 / 1;
      object-fit: cover;
    }

    &:hover + .post-body .post-title {
      color: var(--accent);
    }
  }

  .post-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    text-wrap: pretty;
  }

  .post-title {
    font-size: var(--step-1);

    a {
      text-decoration: none;
    }
  }

  .post-eyebrow {
    font-size: var(--step--1);
    color: var(--gray-11);

    time {
      font-variant-numeric: tabular-nums;
      &::before {
        content: " · ";
        color: var(--gray-8);
      }
    }
  }
</style>
