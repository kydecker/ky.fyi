---
import { getGuestbookEntries } from "../../db/queries/select";
import Notecard from "./Notecard.astro";
import { getPageRange } from "./pagination";

interface Props {
  currentPage: number;
}

const { offset, limit } = getPageRange(Astro.props.currentPage);
const guestbook = await getGuestbookEntries(offset, limit);
---

{guestbook.map((entry) => <Notecard {...entry} randomTranslate />)}
