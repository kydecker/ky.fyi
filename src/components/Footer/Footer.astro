---
import { siteInfo } from "../../constants/site-info";
import { SubscribeForm } from "../Subscribe/SubscribeForm";
import SocialIcon from "./SocialIcon.astro";

const buildDate = new Date();
const lastUpdated = buildDate.toLocaleDateString("en-US", {
  month: "short",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
});
---

<footer>
  <div class="links">
    <a href="/" data-fathom="footer-link">
      Home
    </a>
    <a href="/about" data-fathom="footer-link">
      About
    </a>
    <a href="/projects" data-fathom="footer-link">
      Projects
    </a>
    <a href="/posts" data-fathom="footer-link">
      Writing
    </a>
    <a href="/arrangements" data-fathom="footer-link">
      Sheet Music
    </a>
  </div>
  <div class="links">
    <a href="/now" data-fathom="footer-link">
      Now
    </a>
    <a href="/guestbook" data-fathom="footer-link">
      Guestbook
    </a>
    <a href="/webrings" data-fathom="footer-link">
      Webrings
    </a>
    <a href="/resume" data-fathom="footer-link">
      Resume
    </a>
    <a href="/colophon" data-fathom="footer-link">
      Colophon
    </a>
  </div>
  <ul class="socials">
    {Object.values(siteInfo.socials).map((social) => (
      <li>
        <a
          href={social.href}
          data-fathom="footer-link"
          aria-label={social.name}
        >
          <SocialIcon icon={social.icon} />
        </a>
      </li>
    ))}
  </ul>
  <div class="subscribe">
    <SubscribeForm client:visible />
  </div>
  <div class="banner">
    &copy; Ky Decker. Last updated{" "}
    <time datetime={buildDate.toISOString()}>{lastUpdated}</time>.{" "}
    <a href="https://www.jewishvoiceforpeace.org/" data-fathom="footer-link">
      Free&nbsp;Palestine.
    </a>
  </div>
</footer>

<style>
  footer {
    --gutter: var(--space-xl);
    --content: min(860px, 100% - var(--gutter) * 2);
    --column: calc((var(--content) - var(--gutter) * 2) / 3.5);

    font-size: var(--step-0);
    padding-block: var(--space-2xl);
    width: 100%;
    border-block-start: 1px solid var(--gray-6);
    display: grid;
    grid-template-columns:
      [full-start] 1fr
      [content-start] calc(var(--column) * 0.75)
      calc(var(--column) * 0.75)
      calc(var(--column) * 2) [content-end]
      1fr [full-end];
    grid-template-rows: 1fr auto auto;
    grid-template-areas:
      ". links1 links2 form ."
      ". socials socials form ."
      ". banner banner banner .";
    gap: var(--space-l) var(--gutter);

    @media (width < 650px) {
      grid-template-columns:
        [full-start] 0
        [content-start] 1fr 1fr [content-end]
        0 [full-end];
      grid-template-rows: auto;
      grid-template-areas:
        ". links1 links2 ."
        ". socials socials ."
        "form form form form"
        ". banner banner .";
      gap: var(--gutter);
    }
  }

  .links {
    display: flex;
    align-items: flex-start;
    flex-flow: column wrap;

    --link-padding-block: 0.2em;

    margin-block-start: calc(var(--link-padding-block) * -1);

    @media (width < 650px) {
      --link-padding-block: 0.4em;
    }

    a {
      display: inline-block;
      padding-block: var(--link-padding-block);
      text-decoration: none;
    }

    &:first-child {
      grid-area: links1;
    }

    &:nth-child(2) {
      grid-area: links2;
    }
  }

  .socials {
    grid-area: socials;
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--gray-10);
    list-style: none;
    padding: 0;
    margin-block: 0;
    margin-inline: -8px;

    @media (width >= 650px) {
      margin-block-end: -8px;
    }

    li {
      display: flex;
    }

    a {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      height: 40px;
      width: 40px;
      padding: 8px;
      border-radius: 50%;

      @media (hover: hover) and (pointer: fine) {
        &:hover {
          color: var(--accent);
        }
      }
    }
  }

  .banner {
    grid-area: banner;
    color: var(--gray-11);
    font-size: var(--step--1);
    padding-block-start: var(--space-s);
  }

  .subscribe {
    grid-area: form;
  }
</style>

<script>
  import * as Fathom from "fathom-client";

  document.addEventListener("astro:page-load", () => {
    document
      .querySelectorAll("[data-fathom='footer-link']")
      .forEach((navlink) => {
        navlink.addEventListener("click", () => {
          const url = navlink.getAttribute("href");
          Fathom.trackEvent(`nav: click link (${url})`);
        });
      });
  });
</script>
