---
import { siteInfo } from "../../constants/site-info";
import Center from "../Center.astro";
import { SubscribeForm } from "../Subscribe/SubscribeForm";
import SocialIcon from "./SocialIcon.astro";
---

<footer>
  <Center>
    <div class="content">
      <div class="links">
        <a href="/about" data-fathom="footer-link">
          About
        </a>
        <a href="/projects" data-fathom="footer-link">
          Projects
        </a>
        <a href="/posts" data-fathom="footer-link">
          Writing
        </a>
        <a href="/arrangements" data-fathom="footer-link">
          Sheet Music
        </a>
      </div>
      <div class="links">
        <a href="/guestbook" data-fathom="footer-link">
          Guestbook
        </a>
        <a href="/webrings" data-fathom="footer-link">
          Webrings
        </a>
        <a href="/resume" data-fathom="footer-link">
          Resume
        </a>
        <a href="/colophon" data-fathom="footer-link">
          Colophon
        </a>
      </div>
      <div class="socials">
        {Object.values(siteInfo.socials).map((social) => (
          <a
            href={social.href}
            data-fathom="footer-link"
            aria-label={social.name}
          >
            <SocialIcon icon={social.icon} />
          </a>
        ))}
      </div>
      <div class="banner">
        <a
          href="https://www.jewishvoiceforpeace.org/"
          data-fathom="footer-link"
        >
          Free Palestine.
        </a>
      </div>
      <div class="subscribe">
        <SubscribeForm client:visible />
      </div>
    </div>
  </Center>
</footer>

<style>
  footer {
    font-size: var(--step-0);
    padding-block: var(--space-2xl);
    width: 100%;
    border-block-start: 1px solid var(--gray-6);
  }

  .content {
    display: grid;
    grid-template:
      "links1 links2 form" 1fr
      "socials socials form" auto
      "banner banner form" auto / 0.5fr 0.5fr 2fr;
    gap: var(--space-m) var(--space-xl);

    @media (width < 650px) {
      grid-template:
        "form form"
        "links1 links2"
        "socials socials"
        "banner banner" / 1fr 1fr;
      gap: var(--space-xl);
    }
  }

  .links {
    display: flex;
    align-items: flex-start;
    flex-flow: column wrap;

    --link-padding-block: 0.2em;

    margin-block-start: calc(var(--link-padding-block) * -1);

    @media (width < 650px) {
      --link-padding-block: 0.4em;
    }

    a {
      display: inline-block;
      padding-block: var(--link-padding-block);

      &:not(:hover) {
        text-decoration-color: transparent;
      }
    }

    &:first-child {
      grid-area: links1;
    }

    &:last-child {
      grid-area: links2;
    }
  }

  .socials {
    grid-area: socials;
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--gray-10);
    margin-inline: -8px;

    a {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      height: 40px;
      width: 40px;
      padding: 8px;
      border-radius: 50%;
      transition: color 0.15s ease-out;

      @media (hover: hover) and (pointer: fine) {
        &:hover {
          color: var(--gray-12);
        }
      }

      &:focus-visible {
        color: var(--gray-12);
      }
    }
  }

  .banner {
    grid-area: banner;
    color: var(--gray-11);
    display: flex;
    align-items: center;
    gap: var(--space-s);
    font-size: var(--step--1);

    a {
      text-decoration: none;

      @media (hover: hover) and (pointer: fine) {
        &:hover {
          color: var(--gray-12);
        }
      }
    }
  }

  .subscribe {
    grid-area: form;
  }
</style>

<script>
  import * as Fathom from "fathom-client";

  document.addEventListener("astro:page-load", () => {
    document
      .querySelectorAll("[data-fathom='footer-link']")
      .forEach((navlink) => {
        navlink.addEventListener("click", () => {
          const url = navlink.getAttribute("href");
          Fathom.trackEvent(`nav: click link (${url})`);
        });
      });
  });
</script>
