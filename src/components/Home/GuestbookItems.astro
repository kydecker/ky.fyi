---
import {
  getGuestbookCount,
  getGuestbookEntries,
} from "../../db/queries/select";
import CarouselButton from "../CarouselButton.astro";
import CarouselItem from "../CarouselItem.astro";
import Notecard from "../Notecard/Notecard.astro";

export const LIMIT = 5;

const [guestbook, total] = await Promise.all([
  getGuestbookEntries(0, LIMIT),
  getGuestbookCount(),
]);
---

{guestbook.map((entry) => (
  <CarouselItem>
    <Notecard {...entry} small />
  </CarouselItem>
))}
<CarouselButton url="/guestbook">
  {Math.max(total - LIMIT, 0)} more messages
</CarouselButton>
