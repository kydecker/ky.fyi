---
import {
  getGuestbookCount,
  getGuestbookEntries,
} from "../../db/queries/select";
import CarouselButton from "../CarouselButton.astro";
import CarouselItem from "../CarouselItem.astro";
import Notecard from "../Notecard/Notecard.astro";

const LIMIT = 5;

const [guestbook, result] = await Promise.all([
  getGuestbookEntries(0, LIMIT),
  getGuestbookCount(),
]);
const moreCount = Math.max((result?.count ?? 0) - LIMIT, 0);
---

{guestbook.map(({ author, url, content, timestamp, theme }) => (
  <CarouselItem>
    <Notecard
      author={author}
      url={url}
      content={content}
      timestamp={timestamp}
      theme={theme}
      small
    />
  </CarouselItem>
))}
<CarouselButton url="/guestbook">{moreCount} more messages</CarouselButton>
