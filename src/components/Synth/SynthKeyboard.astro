<style>
  .synth-keys-backdrop {
    fill: var(--synth-between-keys);
  }

  .synth-key {
    cursor: pointer;
    transition: fill 0.4s ease-out;

    .pressed-overlay {
      fill: var(--synth-stroke);
      transform: translateY(2px);
      transition: transform 0.1s ease-out;
    }

    .base {
      transition: fill 0.4s ease-out;
    }

    &.white .base {
      fill: var(--synth-whitekey);
    }

    &.black .base {
      fill: var(--synth-blackkey);
      stroke: var(--synth-stroke);
      stroke-width: 1.5px;
    }

    &.pressed {
      .base {
        transition: none;
      }

      &.white .base {
        fill: var(--synth-whitekey-pressed);
      }

      &.black .base {
        fill: var(--synth-blackkey-pressed);
      }

      .pressed-overlay {
        transition: none;
        transform: translateY(0);
      }
    }
  }

  .key-letter {
    fill: var(--synth-keyletter);
    opacity: 0;
    transform: translateY(4px);
    transition: 0.4s ease-out;

    &.visible {
      opacity: 1;
      transform: translateY(0);
    }

    &.fadeout {
      opacity: 0;
      transition: opacity 1s ease-in;
      transition-delay: 0.2s;
    }
  }
</style>
