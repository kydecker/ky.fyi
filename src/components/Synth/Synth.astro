---
import SynthBase from "./SynthBase.astro";
import SynthKeyboard from "./SynthKeyboard.astro";
import SynthScreen from "./SynthScreen.astro";
---

<script>
  function prepareLoadSynth() {
    const synth = document.getElementById("synth");
    if (!synth) {
      return;
    }
    const start: SVGElement | null = synth.querySelector(".start");

    const begin = () => {
      start?.removeEventListener("click", begin);
      synth.removeEventListener("keydown", handleStartKey);
      synth.dataset.state = "loading";
      import("./synth").then(({ loadSynth }) => loadSynth(synth));
    };

    const handleStartKey = (e: KeyboardEvent) => {
      if (
        (e.key === "Enter" || e.key === " ") &&
        !e.repeat
      ) {
        e.preventDefault();
        begin();
      }
    };

    start?.addEventListener("click", begin);
    synth.addEventListener("keydown", handleStartKey);
  }

  prepareLoadSynth();
</script>

<div
  id="synth"
  class="synth"
  tabindex="0"
  data-state="idle"
>
  <svg
    width="100%"
    viewBox="0 0 270 150"
    version="1.1"
    xmlns="http://www.w3.org/2000/svg"
  >
    <SynthBase />
    <SynthKeyboard />
    <SynthScreen />
  </svg>
</div>

<style>
  .synth {
    width: 100%;
    max-width: 540px;

    --synth-whitekey: #ffffff;
    --synth-whitekey-pressed: #f1f0ef;
    --synth-blackkey: #2a2a28;
    --synth-blackkey-pressed: #111110;
    --synth-between-keys: #cfceca;
    --synth-base: #111110;
    --synth-stroke: #111110;
    --synth-outline: #111110;
    --synth-lcd-bg: #d4e7a6;
    --synth-lcd-light: #f9faf2;
    --synth-lcd-medium: #5b7c2f;
    --synth-lcd-dark: #37401c;
    --synth-keyletter: #b5b3ad;

    svg {
      overflow: visible;
      /* Match the base's rx="12" on its 270×150 viewBox */
      border-radius: calc(12 / 270 * 100%) / calc(12 / 150 * 100%);
      box-shadow: var(--synth-shadow, none);
    }

    &[data-state="loading"],
    &[data-state="spinning"] {
      pointer-events: none;
      cursor: default;
    }

    &:focus-visible {
      border-radius: 24px;
      outline-offset: 4px;
    }
  }

  :global([data-theme="dark"]) .synth {
    --synth-shadow: 0 0 0 4px var(--gray-5);
  }
</style>
