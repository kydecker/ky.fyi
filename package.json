{
  "name": "ky.fyi",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.4.2",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "astro dev",
    "build": "wrangler types && astro check && astro build",
    "build:only": "astro build",
    "preview": "astro preview",
    "check": "astro check && biome check",
    "check:fix": "astro check && biome check --write",
    "test": "playwright test",
    "check-links": "astro build && lychee --config .lychee.toml .",
    "knip": "knip",
    "db:seed:local": "wrangler d1 migrations apply guestbook --local && wrangler d1 execute guestbook --local --file=tests/fixtures/guestbook-seed.sql",
    "deploy": "wrangler deploy",
    "versions-upload": "wrangler versions upload"
  },
  "simple-git-hooks": {
    "pre-commit": "./node_modules/.bin/nano-staged"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.1",
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/mdx": "8.0.1",
    "@astrojs/react": "6.0.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@observablehq/plot": "^0.6.17",
    "astro": "7.3.2",
    "astro-expressive-code": "^0.44.2",
    "astro-lilypond": "^1.1.2",
    "classnames": "^2.5.1",
    "dayjs": "^1.11.23",
    "drizzle-orm": "^0.45.2",
    "howler": "^2.2.4",
    "linkedom": "^0.18.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remark-imgattr": "^1.1.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.13",
    "@playwright/test": "^1.63.0",
    "@types/howler": "^2.2.13",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "knip": "^6.35.1",
    "nano-staged": "^1.0.2",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.131.2"
  },
  "bugs": {
    "url": "https://github.com/kydecker/ky.fyi/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kydecker/ky.fyi"
  }
}
